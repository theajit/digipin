# This example contains no credentials. Never commit a populated copy.
PINID_LITE_ENABLED=true
PINID_ORIGIN=https://name.pincode.cafe
PINID_DATA_DIR=/data
PINID_SINGLE_WRITER=false
PINID_STORAGE_CONFIRMED=false
PORT=5001
PINID_HOST=127.0.0.1
# Three DISTINCT random 32-byte base64url values, generated with Node crypto.
PINID_ENCRYPTION_KEY=
PINID_SESSION_SECRET=
PINID_ADMIN_SECRET=

# Optional PostgreSQL replacement; SQLite remains default.
# PINID_STORAGE_BACKEND=postgres
# PINID_STORAGE_VERSION=postgres-v1
# PINID_AUTO_MIGRATE=true
# PINID_DATABASE_URL=postgresql://runtime-user:YOUR-SECRET@database-host:5432/pinid
# PINID_MIGRATION_DATABASE_URL=postgresql://migration-user:YOUR-SECRET@database-host:5432/pinid
# PINID_DB_SCHEMA=pinid
# PINID_DB_POOL_MAX=5
# PINID_DB_CONNECTION_TIMEOUT_MS=5000
# PINID_PG_TLS=verify-full
# Set TLS=disable only explicitly for an isolated trusted network without TLS.
# PostgreSQL mode ignores PINID_DATA_DIR and SQLite storage confirmation flags.
