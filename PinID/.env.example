# This example contains no credentials. Never commit a populated copy.
PINID_LITE_ENABLED=false
PINID_ORIGIN=https://name.pincode.cafe
PINID_DATA_DIR=/data
PINID_SINGLE_WRITER=false
PINID_STORAGE_CONFIRMED=false
# Three DISTINCT random 32-byte base64url values, generated with Node crypto.
PINID_ENCRYPTION_KEY=
PINID_SESSION_SECRET=
PINID_ADMIN_SECRET=
